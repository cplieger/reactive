{
  "name": "@cplieger/reactive",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./signal": "./src/signal/index.ts",
    "./dom": "./src/dom/index.ts",
    "./fetch": "./src/fetch/index.ts",
    "./actions": "./src/actions/index.ts",
    "./actions/testing": "./src/actions/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:knip": "knip",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "knip": "6.44.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "rolldown": "1.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "minimatch": "^11.0.1"
  },
  "files": [
    "src/",
    "jsr.json",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "!src/**/*.test.ts",
    "!src/**/*-setup.ts",
    "!src/**/test-helpers/**"
  ],
  "description": "Build framework-free TypeScript browser apps from signals, keyed DOM rendering, typed JSON requests and server actions",
  "license": "Apache-2.0",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplieger/reactive.git"
  },
  "homepage": "https://github.com/cplieger/reactive",
  "bugs": {
    "url": "https://github.com/cplieger/reactive/issues"
  },
  "author": "cplieger <917744+cplieger@users.noreply.github.com>",
  "keywords": [
    "signals",
    "reactivity",
    "computed",
    "effect",
    "dom",
    "reconciliation",
    "store",
    "fetch",
    "actions",
    "optimistic-updates",
    "zero-dependency",
    "typescript"
  ]
}
