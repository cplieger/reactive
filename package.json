    "@stryker-mutator/vitest-runner": "9.6.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "overrides": {
